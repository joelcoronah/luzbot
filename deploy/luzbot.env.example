# Copy to /etc/luzbot/luzbot.env and `chmod 600` it. Never commit the real file.

# From @BotFather
TELEGRAM_TOKEN=123456789:replace-me
# Your chat id (see README: "Create the Telegram bot")
TELEGRAM_CHAT_ID=123456789
# Shared secret for the home device. Generate with:
#   python3 -c 'import secrets; print(secrets.token_urlsafe(32))'
HEARTBEAT_TOKEN=replace-me-with-a-long-random-string

# Seconds without heartbeats before declaring an outage (min 60)
TIMEOUT_SECONDS=180
# Display timezone and bot language (es | en)
TIMEZONE=America/Caracas
LANGUAGE=es

# Bind to localhost: Caddy terminates HTTPS in front of it
LISTEN_HOST=127.0.0.1
LISTEN_PORT=8787
DB_PATH=/var/lib/luzbot/luzbot.db
LOG_LEVEL=INFO
